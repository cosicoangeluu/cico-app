# Copy this file to .env.local and fill in the values from your Supabase project.
# See SUPABASE_SETUP.md for where to find each one.

# Project Settings -> Data API -> Project URL (only up to .supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings -> API Keys -> Publishable key (starts with sb_publishable_)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
